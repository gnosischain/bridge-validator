# RPC Endpoints (Required)
# Supports comma-separated URLs for fallback providers
# Example: ETH_RPC=https://rpc1.example.com,https://rpc2.example.com,https://rpc3.example.com
ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/your-api-key
GC_RPC=https://rpc.gnosischain.com
ETH_BC_RPC=https://eth-mainnet.g.alchemy.com/v2/your-api-key
GC_BC_RPC=https://rpc.gnosischain.com

# Example with multiple fallback RPCs:
# ETH_RPC=https://eth1.example.com,https://eth2.example.com,https://eth3.example.com
# GC_RPC=https://gc1.example.com,https://gc2.example.com
# ETH_BC_RPC=https://beacon1.example.com,https://beacon2.example.com
# GC_BC_RPC=https://gc-beacon1.example.com,https://gc-beacon2.example.com

# Validator Private Keys (Optional - only needed for sending transactions)
XDAI_VALIDATOR_PRIV_KEY=
AMB_VALIDATOR_PRIV_KEY=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Bridge Contract Addresses (Optional - defaults are provided)
ETH_AMB_BRIDGE_ADDRESS=0x4C36d2919e407f0Cc2Ee3c993ccF8ac26d9CE64e
GC_AMB_BRIDGE_ADDRESS=0x75Df5AF045d91108662D8080fD1FEFAd6aA0bb59
ETH_XDAI_BRIDGE_ADDRESS=0x4aa42145Aa6Ebf72e164C9bBC74fbD3788045016
GC_XDAI_BRIDGE_ADDRESS=0x7301CFA0e1756B71869E93d4e4Dca5c7d0eb0AA6

# Block processing mode, per chain: block-finality | fcr (default: block-finality)
ETH_BLOCK_PROCESSING_MODE=block-finality
GC_BLOCK_PROCESSING_MODE=block-finality

# Polling interval in seconds (default: 10)
POLL_INTERVAL_SECS=10

# How often the fcr checker revalidates safe-processed blocks that have since
# finalized, in seconds (default: 30). Only used when a chain is in fcr mode.
FCR_CHECK_INTERVAL_SECS=30
MAX_RETRY_COUNT=5

# Largest block span the indexer requests in a single eth_getLogs call
# (default: 2000). Wider catch-up ranges are split into consecutive chunks.
# Lower it if your provider rejects log queries; raising it above the
# provider's cap makes the indexer stall.
MAX_BLOCK_RANGE=2000

XDAI_EXECUTE_MESSAGE_ON_FOREIGN=true # true if execute message from GC -> ETH
AMB_EXECUTE_MESSAGE_ON_FOREIGN=true

# Logging level (default: info)
# Options: error, warn, info, debug, trace
RUST_LOG=debug
