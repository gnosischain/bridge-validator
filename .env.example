# RPC Endpoints (Required)
ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/your-api-key
GC_RPC=https://rpc.gnosischain.com
ETH_BC_RPC=https://eth-mainnet.g.alchemy.com/v2/your-api-key
GC_BC_RPC=https://rpc.gnosischain.com

# Validator Private Keys (Optional - only needed for sending transactions)
XDAI_VALIDATOR_PRIV_KEY=
AMB_VALIDATOR_PRIV_KEY=

# Bridge Contract Addresses (Optional - defaults are provided)
ETH_AMB_BRIDGE_ADDRESS=0x4C36d2919e407f0Cc2Ee3c993ccF8ac26d9CE64e
GC_AMB_BRIDGE_ADDRESS=0x75Df5AF045d91108662D8080fD1FEFAd6aA0bb59
ETH_XDAI_BRIDGE_ADDRESS=0x4aa42145Aa6Ebf72e164C9bBC74fbD3788045016
GC_XDAI_BRIDGE_ADDRESS=0x7301CFA0e1756B71869E93d4e4Dca5c7d0eb0AA6

# Polling interval in seconds (default: 10)
POLL_INTERVAL_SECS=10

# Logging level (default: info)
# Options: error, warn, info, debug, trace
RUST_LOG=info
